<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ch.plaintext.demo</groupId>
        <artifactId>plaintext-demo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>plaintext-demo-webapp</artifactId>

    <dependencies>
        <dependency>
            <groupId>ch.plaintext.v2</groupId>
            <artifactId>plaintext-root-webapp</artifactId>
            <!-- Public demo, everyone is root (Karte 2042, Entscheid Daniel B): no outgoing calls, no secret store.
                 These four are opt-out modules per root's docs/OPTIONAL_MODULES.md; apitoken and sessions are
                 not, the demo guard switches their pages off instead. -->
            <exclusions>
                <exclusion>
                    <groupId>ch.plaintext.v2</groupId>
                    <artifactId>plaintext-admin-webhooks</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.plaintext.v2</groupId>
                    <artifactId>plaintext-admin-secrets</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.plaintext.v2</groupId>
                    <artifactId>plaintext-admin-sidecars</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.plaintext.v2</groupId>
                    <artifactId>plaintext-admin-claude</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ch.plaintext.demo</groupId>
            <artifactId>plaintext-demo-daten</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- Modules declare the MCP server provided (like in plaintext-app, Karte 1721); without it a
                 module with MCP tools (e.g. drawio on demo.plaintext.ch) does not load. /mcp stays behind
                 root's bearer filter, and the demo issues no tokens. -->
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>2.0.2</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- PropertiesLauncher: an instance can add module jars with -Dloader.path=<dir>
                         (demo.plaintext.ch adds modules that are not part of this public repo). -->
                    <layout>ZIP</layout>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
