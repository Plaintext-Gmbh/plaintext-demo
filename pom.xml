<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.plaintext.v2</groupId>
        <artifactId>plaintext-root-parent</artifactId>
        <version>3.19.0</version>
        <relativePath/>
    </parent>

    <groupId>ch.plaintext.demo</groupId>
    <artifactId>plaintext-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>plaintext-demo</name>
    <description>Public demo application on plaintext-root</description>

    <properties>
        <plaintext-root.version>3.19.0</plaintext-root.version>
    </properties>

    <modules>
        <module>plaintext-demo-oauth-mock</module>
        <module>plaintext-demo-tabelle</module>
        <module>plaintext-demo-daten</module>
        <module>plaintext-demo-webapp</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.plaintext.v2</groupId>
                <artifactId>plaintext-root-webapp</artifactId>
                <version>${plaintext-root.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.plaintext.v2</groupId>
                <artifactId>plaintext-root-tablesettings</artifactId>
                <version>${plaintext-root.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- root artifacts are published to GitHub Packages (needs a token with read:packages). -->
        <repository>
            <id>plaintext</id>
            <url>https://maven.pkg.github.com/Plaintext-Gmbh/plaintext-mvn</url>
        </repository>
    </repositories>
</project>
